---
import { createT } from "../lib/i18n";

const locale = (Astro.locals?.locale ?? "en") as "en" | "th";
const t = createT(locale);
---

<footer class="bg-surface-container-low w-full mt-20 border-t border-outline-variant/30">
  <div class="max-w-container-max mx-auto px-5 md:px-16 py-14">
    <div class="flex flex-col md:flex-row justify-between gap-12">
      <div class="max-w-xs">
        <a href="/" class="font-display text-2xl font-bold tracking-tight text-on-surface">SAKNID</a>
        <p class="font-body text-sm text-on-surface-variant mt-4 leading-relaxed">
          {t("footer.tagline")}
        </p>
      </div>

      <div class="grid grid-cols-3 gap-8 md:gap-16">
        <div>
          <h5 class="font-body text-label-md font-semibold text-on-surface mb-4 uppercase tracking-wider">{t("footer.galleryTitle")}</h5>
          <div class="flex flex-col gap-2.5">
            <a href="/market" class="font-body text-sm text-on-surface-variant hover:text-primary-container transition-colors duration-200">{t("footer.browsePlates")}</a>
            <a href="/wallet" class="font-body text-sm text-on-surface-variant hover:text-primary-container transition-colors duration-200">{t("footer.yourCollection")}</a>
          </div>
        </div>
        <div>
          <h5 class="font-body text-label-md font-semibold text-on-surface mb-4 uppercase tracking-wider">{t("footer.artistsTitle")}</h5>
          <div class="flex flex-col gap-2.5">
            <a href="/artists" class="font-body text-sm text-on-surface-variant hover:text-primary-container transition-colors duration-200">{t("footer.theRoster")}</a>
            <a href="/booking" class="font-body text-sm text-on-surface-variant hover:text-primary-container transition-colors duration-200">{t("footer.bookSession")}</a>
          </div>
        </div>
        <div>
          <h5 class="font-body text-label-md font-semibold text-on-surface mb-4 uppercase tracking-wider">{t("footer.houseTitle")}</h5>
          <div class="flex flex-col gap-2.5">
            <a href="/#how-it-works" class="font-body text-sm text-on-surface-variant hover:text-primary-container transition-colors duration-200">{t("footer.howItWorks")}</a>
          </div>
        </div>
      </div>
    </div>

    <div class="mt-12 pt-6 border-t border-outline-variant/30 flex flex-col md:flex-row justify-between items-center gap-4">
      <span class="font-body text-xs text-on-surface-variant">{t("footer.copyright")}</span>
      <span class="font-body text-xs text-on-surface-variant">{t("footer.locations")}</span>
    </div>
  </div>
</footer>

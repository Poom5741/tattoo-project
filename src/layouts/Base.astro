---
export interface Props {
  title?: string;
  description?: string;
}

const { title = "INKNOIR — One-of-one tattoo plates", description = "One-of-one tattoo plates. Blockchain-verified ownership." } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bodoni+Moda:ital,opsz,wght@0,6..96,400;0,6..96,500;1,6..96,400&family=Playfair+Display:ital,wght@0,400;0,500;1,400&family=Spectral:ital,wght@0,300;0,400;0,500;1,400&family=Archivo:wght@300;400;500;600&family=IBM+Plex+Sans:wght@300;400;500&family=Space+Mono:wght@400;700&family=JetBrains+Mono:wght@400;500&family=IBM+Plex+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/styles/global.css" />
  </head>
  <body>
    <slot />
    <script>
      // B7 — delete legacy prototype localStorage keys on first app load
      try {
        localStorage.removeItem("inknoir_col");
        localStorage.removeItem("inknoir_book");
      } catch (_) {}
    </script>
  </body>
</html>

---
import "../styles/global.css";

export interface Props {
  title?: string;
  description?: string;
}

const { title = "SUKNID — One-of-one tattoo plates", description = "One-of-one tattoo plates. Blockchain-verified ownership." } = Astro.props;

// Tawk.to live-chat widget. Loads on all public pages, suppressed on the
// blocked prefixes below. Add wallet/signing routes here (e.g. "/checkout",
// "/wallet") if the third-party-script risk on those pages is deemed
// unacceptable — see .omc/plans/live-chat-widget-tawkto.md (ADR).
const widgetBlockedPrefixes = ["/admin", "/checkout", "/wallet"];
const isBlocked = widgetBlockedPrefixes.some((p) => Astro.url.pathname.startsWith(p));
const tawkProperty = import.meta.env.PUBLIC_TAWK_PROPERTY_ID;
const tawkWidget = import.meta.env.PUBLIC_TAWK_WIDGET_ID;
const showTawk = !isBlocked && Boolean(tawkProperty) && Boolean(tawkWidget);
const tawkSrc = showTawk ? `https://embed.tawk.to/${tawkProperty}/${tawkWidget}` : null;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;500;600;700&family=Sora:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <slot />
    <script>
      // B7 — delete legacy prototype localStorage keys on first app load
      try {
        localStorage.removeItem("suknid_col");
        localStorage.removeItem("suknid_book");
      } catch (_) {}
    </script>
    {
      showTawk && (
        <script is:inline define:vars={{ tawkSrc }}>
          var Tawk_API = Tawk_API || {},
            Tawk_LoadStart = new Date();
          (function () {
            var s1 = document.createElement("script"),
              s0 = document.getElementsByTagName("script")[0];
            s1.async = true;
            s1.src = tawkSrc;
            s1.charset = "UTF-8";
            s1.crossOrigin = "anonymous";
            s0.parentNode.insertBefore(s1, s0);
          })();
        </script>
      )
    }
  </body>
</html>

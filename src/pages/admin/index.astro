---
export const prerender = false;

import Base from "../../layouts/Base.astro";
import { isAdminAuthed } from "../../lib/admin/auth";
import AdminPendingReview from "../../components/AdminPendingReview";

const env = Astro.locals.runtime.env;
const cookieHeader = Astro.request.headers.get("cookie") ?? "";
const authed = await isAdminAuthed(cookieHeader, env.SESSION);

interface BookingRow {
  id: number;
  artist_id: string;
  design_id: string | null;
  name: string;
  contact: string;
  message: string | null;
  created_at: number;
}

interface DesignRow {
  id: string;
  n: string;
  title: string;
  artist_id: string;
  style: string | null;
  price: number | null;
  status: string;
}

interface ArtistRow {
  id: string;
  name: string;
  wallet_address?: string | null;
}

let bookings: BookingRow[] = [];
let designs: DesignRow[] = [];
let artists: ArtistRow[] = [];

if (authed) {
  const db = env.DB;
  const [bRes, dRes, aRes] = await Promise.all([
    db.prepare("SELECT * FROM booking_inquiries ORDER BY created_at DESC").all<BookingRow>(),
    db.prepare("SELECT id, n, title, artist_id, style, price, status FROM designs ORDER BY rowid ASC").all<DesignRow>(),
    db.prepare("SELECT id, name, wallet_address FROM artists ORDER BY name ASC").all<ArtistRow>(),
  ]);
  bookings = bRes.results;
  designs = dRes.results;
  artists = aRes.results;
}

const artistMap = Object.fromEntries(artists.map((a) => [a.id, a.name]));
const stats = {
  bookings: bookings.length,
  pending: designs.filter((d) => d.status === "pending").length,
  available: designs.filter((d) => d.status === "available").length,
  reserved: designs.filter((d) => d.status === "reserved").length,
  sold: designs.filter((d) => d.status === "sold").length,
};

function statusClass(status: string): string {
  switch (status) {
    case "available": return "bg-green-50 text-green-700 border-green-200";
    case "reserved": return "bg-amber-50 text-amber-600 border-amber-200";
    case "sold": return "bg-surface-container-high text-on-surface-variant border-outline-variant/40";
    case "pending": return "bg-amber-50 text-amber-600 border-amber-200";
    case "rejected": return "bg-error/container text-error border-error/20";
    case "delisted": return "bg-surface-container-high text-on-surface-variant border-outline-variant/40";
    default: return "";
  }
}

function fmtDate(ts: number) {
  return new Date(ts * 1000).toLocaleString("en-GB", {
    day: "2-digit", month: "short", year: "numeric",
    hour: "2-digit", minute: "2-digit",
  });
}

/* Shared table header class */
const thBase = "font-body text-label-sm tracking-wider uppercase text-on-surface-variant/60 px-4 py-3 text-left border-b border-outline-variant bg-surface-container-low whitespace-nowrap";
/* Shared table body cell class */
const tdBase = "px-4 py-3 border-b border-outline-variant/40 text-body-md font-body";
---

<Base title="Admin — SAKNID">
  <style>
    #login-err {
      font-family: 'Sora', sans-serif;
      font-size: 12px;
      color: #ba1a1a;
      margin-top: 10px;
      display: none;
    }
  </style>

  {!authed ? (
    <div class="min-h-screen flex items-center justify-center bg-surface px-5">
      <div class="w-full max-w-[400px] card-bb p-10">
        <div class="kicker font-body text-label-md font-semibold text-primary-container tracking-wider uppercase mb-5">SAKNID / Admin</div>
        <h1 class="font-display text-headline-sm text-on-surface mb-7">Sign in</h1>
        <form id="lf" novalidate>
          <div class="mb-5">
            <label for="pw" class="label-bb">Password</label>
            <input id="pw" type="password" class="input-bb" placeholder="••••••••" autocomplete="current-password" />
          </div>
          <div id="login-err"></div>
          <button type="submit" class="btn-primary w-full mt-5">Enter dashboard</button>
        </form>
        <script>
          document.getElementById("lf")?.addEventListener("submit", async (e) => {
            e.preventDefault();
            const pw = (document.getElementById("pw") as HTMLInputElement).value;
            const errEl = document.getElementById("login-err");
            try {
              const res = await fetch("/api/admin/login", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ password: pw }),
              });
              if (res.ok) {
                location.reload();
                return;
              }
              const body = await res.json().catch(() => ({}));
              if (errEl) {
                errEl.textContent = body?.error ?? "Login failed";
                errEl.style.display = "block";
              }
            } catch {
              if (errEl) {
                errEl.textContent = "Network error — check your connection";
                errEl.style.display = "block";
              }
            }
          });
        </script>
      </div>
    </div>
  ) : (
    <div class="max-w-container-max mx-auto px-5 md:px-16 py-10 pb-20">
      {/* ── Header ── */}
      <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 pb-6 border-b border-outline-variant mb-10">
        <div>
          <div class="kicker font-body text-label-md font-semibold text-primary-container tracking-wider uppercase mb-2">SAKNID / Admin</div>
          <h1 class="font-display text-headline-md text-on-surface">Dashboard</h1>
        </div>
        <form method="POST" action="/api/admin/logout">
          <button type="submit" class="btn-secondary">Sign out</button>
        </form>
      </div>

      {/* ── Stats ── */}
      <div class="stats grid grid-cols-2 md:grid-cols-5 gap-4 mb-12">
        <div class="card-bb p-6">
          <div class="font-display text-4xl md:text-5xl leading-none text-on-surface">{stats.bookings}</div>
          <div class="font-body text-label-sm tracking-wider uppercase text-on-surface-variant/60 mt-2">Bookings</div>
        </div>
        <div class="card-bb p-6">
          <div class="font-display text-4xl md:text-5xl leading-none text-amber-500">{stats.pending}</div>
          <div class="font-body text-label-sm tracking-wider uppercase text-on-surface-variant/60 mt-2">Pending review</div>
        </div>
        <div class="card-bb p-6">
          <div class="font-display text-4xl md:text-5xl leading-none text-green-600">{stats.available}</div>
          <div class="font-body text-label-sm tracking-wider uppercase text-on-surface-variant/60 mt-2">Available</div>
        </div>
        <div class="card-bb p-6">
          <div class="font-display text-4xl md:text-5xl leading-none text-amber-500">{stats.reserved}</div>
          <div class="font-body text-label-sm tracking-wider uppercase text-on-surface-variant/60 mt-2">Reserved</div>
        </div>
        <div class="card-bb p-6">
          <div class="font-display text-4xl md:text-5xl leading-none text-on-surface">{stats.sold}</div>
          <div class="font-body text-label-sm tracking-wider uppercase text-on-surface-variant/60 mt-2">Sold</div>
        </div>
      </div>

      {/* ── Pending design review ── */}
      <div class="font-body text-label-sm tracking-wider uppercase text-on-surface-variant mb-4">Pending design review</div>
      <div class="card-bb p-6 mb-12 border-amber-200/50">
        <AdminPendingReview client:load />
      </div>

      {/* ── Booking inquiries ── */}
      <div class="font-body text-label-sm tracking-wider uppercase text-on-surface-variant mb-4">Booking inquiries</div>
      {bookings.length === 0 ? (
        <p class="font-body text-body-md text-on-surface-variant/60 mb-12">No bookings yet.</p>
      ) : (
        <div class="overflow-x-auto mb-12">
          <table class="w-full border border-outline-variant/40 border-collapse rounded-lg overflow-hidden">
            <thead>
              <tr>
                <th class={thBase}>#</th>
                <th class={thBase}>Date</th>
                <th class={thBase}>Name</th>
                <th class={thBase}>Contact</th>
                <th class={thBase}>Artist</th>
                <th class={thBase}>Plate</th>
                <th class={thBase}>Message</th>
              </tr>
            </thead>
            <tbody>
              {bookings.map((b) => (
                <tr class="hover:bg-surface-container-low/50 transition-colors">
                  <td class={`${tdBase} text-label-sm text-on-surface-variant/60`}>{b.id}</td>
                  <td class={`${tdBase} text-label-sm whitespace-nowrap`}>{fmtDate(b.created_at)}</td>
                  <td class={`${tdBase} font-medium text-on-surface`}>{b.name}</td>
                  <td class={`${tdBase} text-body-md`}>{b.contact}</td>
                  <td class={`${tdBase} text-body-md`}>{artistMap[b.artist_id] ?? b.artist_id}</td>
                  <td class={`${tdBase} text-label-sm text-on-surface-variant/60`}>{b.design_id ?? "—"}</td>
                  <td class={`${tdBase}`}><div class="text-body-md text-on-surface-variant max-w-[260px] truncate">{b.message ?? "—"}</div></td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )}

      {/* ── All plates ── */}
      <div class="font-body text-label-sm tracking-wider uppercase text-on-surface-variant mb-4">All plates</div>
      <div class="overflow-x-auto mb-12">
        <table class="w-full border border-outline-variant/40 border-collapse rounded-lg overflow-hidden">
          <thead>
            <tr>
              <th class={thBase}>№</th>
              <th class={thBase}>Title</th>
              <th class={thBase}>Artist</th>
              <th class={thBase}>Style</th>
              <th class={thBase}>Price</th>
              <th class={thBase}>Status</th>
            </tr>
          </thead>
          <tbody>
            {designs.map((d) => (
              <tr class="hover:bg-surface-container-low/50 transition-colors">
                <td class={`${tdBase} text-label-sm text-on-surface-variant/60`}>{d.n}</td>
                <td class={`${tdBase}`}><a href={`/design/${d.id}`} class="text-primary-container underline underline-offset-3 hover:text-primary transition-colors">{d.title}</a></td>
                <td class={`${tdBase} text-body-md`}>{artistMap[d.artist_id] ?? d.artist_id}</td>
                <td class={`${tdBase} text-label-sm text-on-surface-variant/60`}>{d.style ?? "—"}</td>
                <td class={`${tdBase} text-body-md`}>{d.price != null ? `฿${d.price.toLocaleString("th-TH", { minimumFractionDigits: 2 })}` : "—"}</td>
                <td class={`${tdBase}`}>
                  <span class={`inline-flex items-center gap-2 px-3 py-1.5 rounded-full text-xs font-semibold border ${statusClass(d.status)}`}>
                    <span class="w-2 h-2 rounded-full bg-current"></span>{d.status}
                  </span>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      {/* ── Register new artist ── */}
      <div class="font-body text-label-sm tracking-wider uppercase text-on-surface-variant mb-4 mt-6">Register new artist</div>
      <form method="POST" action="/api/admin/register-artist"
        class="grid grid-cols-1 sm:grid-cols-2 gap-4 card-bb p-6 mb-9">
        <div>
          <label class="label-bb text-label-sm">Name *</label>
          <input type="text" name="name" class="input-bb text-body-md py-2" required placeholder="Artist name" />
        </div>
        <div>
          <label class="label-bb text-label-sm">Handle</label>
          <input type="text" name="handle" class="input-bb text-body-md py-2" placeholder="@handle" />
        </div>
        <div>
          <label class="label-bb text-label-sm">City</label>
          <input type="text" name="city" class="input-bb text-body-md py-2" placeholder="Bangkok" />
        </div>
        <div>
          <label class="label-bb text-label-sm">Style</label>
          <input type="text" name="style" class="input-bb text-body-md py-2" placeholder="Neo-traditional" />
        </div>
        <div>
          <label class="label-bb text-label-sm">Email</label>
          <input type="email" name="email" class="input-bb text-body-md py-2" placeholder="artist@email.com" />
        </div>
        <div>
          <label class="label-bb text-label-sm">Wallet address</label>
          <input type="text" name="walletAddress" class="input-bb text-body-md py-2 font-mono" placeholder="0x…" />
        </div>
        <div class="sm:col-span-2">
          <button type="submit" class="btn-primary text-label-md py-2 px-6">Register artist</button>
        </div>
      </form>

      {/* ── Artist wallet addresses ── */}
      <div class="font-body text-label-sm tracking-wider uppercase text-on-surface-variant mb-4">Artist wallet addresses</div>
      <div class="overflow-x-auto mb-12">
        <table class="w-full border border-outline-variant/40 border-collapse rounded-lg overflow-hidden">
          <thead>
            <tr>
              <th class={thBase}>Artist</th>
              <th class={thBase}>ID</th>
              <th class={thBase}>Current wallet</th>
              <th class={thBase}>Update</th>
            </tr>
          </thead>
          <tbody>
            {artists.map((a) => (
              <tr class="hover:bg-surface-container-low/50 transition-colors">
                <td class={`${tdBase} font-medium text-on-surface`}>{a.name}</td>
                <td class={`${tdBase} text-label-sm text-on-surface-variant/60 font-mono`}>{a.id}</td>
                <td class={`${tdBase} text-label-sm font-mono max-w-[200px] truncate`}>
                  {a.wallet_address ? a.wallet_address : <span class="text-on-surface-variant/40">not set</span>}
                </td>
                <td class={tdBase}>
                  <form method="POST" action="/api/admin/update-artist-wallet"
                    class="flex gap-2 items-center">
                    <input type="hidden" name="artistId" value={a.id} />
                    <input type="text" name="walletAddress" class="input-bb text-label-sm font-mono w-[280px] py-1.5"
                      placeholder="0x…"
                      value={a.wallet_address ?? ""} />
                    <button type="submit" class="btn-secondary text-label-sm py-1.5 px-4">
                      Save
                    </button>
                  </form>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  )}
</Base>

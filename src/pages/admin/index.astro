---
export const prerender = false;

import Base from "../../layouts/Base.astro";
import { isAdminAuthed } from "../../lib/admin/auth";
import AdminPendingReview from "../../components/AdminPendingReview";

const env = Astro.locals.runtime.env;
const authed = await isAdminAuthed(
  Astro.request.headers.get("cookie") ?? "",
  env.SESSION
);

interface BookingRow {
  id: number;
  artist_id: string;
  design_id: string | null;
  name: string;
  contact: string;
  message: string | null;
  created_at: number;
}

interface DesignRow {
  id: string;
  n: string;
  title: string;
  artist_id: string;
  style: string | null;
  price: number | null;
  status: string;
}

interface ArtistRow {
  id: string;
  name: string;
  wallet_address?: string | null;
}

let bookings: BookingRow[] = [];
let designs: DesignRow[] = [];
let artists: ArtistRow[] = [];

if (authed) {
  const db = env.DB;
  const [bRes, dRes, aRes] = await Promise.all([
    db.prepare("SELECT * FROM booking_inquiries ORDER BY created_at DESC").all<BookingRow>(),
    db.prepare("SELECT id, n, title, artist_id, style, price, status FROM designs ORDER BY rowid ASC").all<DesignRow>(),
    db.prepare("SELECT id, name, wallet_address FROM artists ORDER BY name ASC").all<ArtistRow>(),
  ]);
  bookings = bRes.results;
  designs = dRes.results;
  artists = aRes.results;
}

const artistMap = Object.fromEntries(artists.map((a) => [a.id, a.name]));
const stats = {
  bookings: bookings.length,
  pending: designs.filter((d) => d.status === "pending").length,
  available: designs.filter((d) => d.status === "available").length,
  reserved: designs.filter((d) => d.status === "reserved").length,
  sold: designs.filter((d) => d.status === "sold").length,
};

function statusClass(status: string): string {
  switch (status) {
    case "available": return "bg-[#2E7D32]/15 text-[#2E7D32] border-[#2E7D32]/40";
    case "reserved": return "bg-[#F9A825]/15 text-[#F9A825] border-[#F9A825]/40";
    case "sold": return "bg-[#5A5B55]/15 text-[#5A5B55] border-[#5A5B55]/40";
    case "pending": return "bg-[#F9A825]/15 text-[#F9A825] border-[#F9A825]/40";
    case "rejected": return "bg-[#D32F2F]/15 text-[#D32F2F] border-[#D32F2F]/40";
    case "delisted": return "bg-[#5A5B55]/15 text-[#5A5B55] border-[#5A5B55]/40";
    default: return "";
  }
}

function fmtDate(ts: number) {
  return new Date(ts * 1000).toLocaleString("en-GB", {
    day: "2-digit", month: "short", year: "numeric",
    hour: "2-digit", minute: "2-digit",
  });
}
---

<Base title="Admin — INKNOIR">
  <style>
    #login-err { font-family: var(--font-mono); font-size: 11px; color: var(--warn); margin-top: 10px; display: none; }
  </style>

  {!authed ? (
    <div class="min-h-screen flex items-center justify-center">
      <div class="w-[360px] border border-[#E8E3D8] bg-[#F0EBE1] p-10 rounded-lg">
        <div class="font-sora font-semibold text-xs tracking-[0.2em] uppercase text-[#E60023]" style="margin-bottom: 18px;">INKNOIR / Admin</div>
        <h1 class="font-playfair font-semibold text-[#1B1C18]" style="font-size: 30px; margin-bottom: 28px;">Sign in</h1>
        <form id="lf" novalidate>
          <div class="mb-5">
            <label for="pw" class="block font-sora font-semibold text-sm text-[#5A5B55] mb-2">Password</label>
            <input id="pw" type="password" class="w-full bg-[#F5F0E8] border border-[#E8E3D8] text-[#1B1C18] font-sora text-sm px-4 py-3 rounded-lg outline-none focus:border-[#E60023] transition-colors" placeholder="••••••••" autocomplete="current-password" />
          </div>
          <div id="login-err">Incorrect password.</div>
          <button type="submit" class="inline-flex items-center justify-center gap-2 px-8 py-4 text-base rounded-full font-sora font-semibold text-sm transition-all bg-[#E60023] text-white hover:bg-[#C4001F] disabled:opacity-40 w-full" style="margin-top: 22px;">Enter dashboard</button>
        </form>
        <script>
          document.getElementById("lf")?.addEventListener("submit", async (e) => {
            e.preventDefault();
            const pw = (document.getElementById("pw") as HTMLInputElement).value;
            const res = await fetch("/api/admin/login", {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({ password: pw }),
            });
            if (res.ok) {
              location.reload();
            } else {
              const el = document.getElementById("login-err");
              if (el) el.style.display = "block";
            }
          });
        </script>
      </div>
    </div>
  ) : (
    <div class="max-w-[1100px] mx-auto px-7 py-10 pb-20">
      <div class="flex justify-between items-center pb-6 border-b border-[#E8E3D8] mb-10">
        <div>
          <div class="font-sora font-semibold text-xs tracking-[0.2em] uppercase text-[#E60023]" style="margin-bottom: 8px;">INKNOIR / Admin</div>
          <h1 class="font-playfair font-semibold text-[#1B1C18]" style="font-size: 34px;">Dashboard</h1>
        </div>
        <form method="POST" action="/api/admin/logout">
          <button type="submit" class="inline-flex items-center justify-center gap-2 px-7 py-3 rounded-full font-sora font-semibold text-sm transition-all bg-transparent text-[#1B1C18] border border-[#E8E3D8] hover:border-[#D4CFC4]">Sign out</button>
        </form>
      </div>

      <div class="grid grid-cols-2 md:grid-cols-5 gap-px bg-[#E8E3D8] border border-[#E8E3D8] mb-12 rounded-lg overflow-hidden">
        <div class="bg-[#F0EBE1] p-6 md:p-7"><div class="font-playfair text-4xl md:text-5xl leading-none">{stats.bookings}</div><div class="font-sora text-[9px] tracking-[0.2em] uppercase text-[#5A5B55]/60 mt-2">Bookings</div></div>
        <div class="bg-[#F0EBE1] p-6 md:p-7"><div class="font-playfair text-4xl md:text-5xl leading-none text-[#F9A825]">{stats.pending}</div><div class="font-sora text-[9px] tracking-[0.2em] uppercase text-[#5A5B55]/60 mt-2">Pending review</div></div>
        <div class="bg-[#F0EBE1] p-6 md:p-7"><div class="font-playfair text-4xl md:text-5xl leading-none text-[#2E7D32]">{stats.available}</div><div class="font-sora text-[9px] tracking-[0.2em] uppercase text-[#5A5B55]/60 mt-2">Available</div></div>
        <div class="bg-[#F0EBE1] p-6 md:p-7"><div class="font-playfair text-4xl md:text-5xl leading-none text-[#F9A825]">{stats.reserved}</div><div class="font-sora text-[9px] tracking-[0.2em] uppercase text-[#5A5B55]/60 mt-2">Reserved</div></div>
        <div class="bg-[#F0EBE1] p-6 md:p-7"><div class="font-playfair text-4xl md:text-5xl leading-none">{stats.sold}</div><div class="font-sora text-[9px] tracking-[0.2em] uppercase text-[#5A5B55]/60 mt-2">Sold</div></div>
      </div>

      <div class="font-sora text-[10.5px] tracking-[0.2em] uppercase text-[#5A5B55] mb-4">Pending design review</div>
      <div class="border border-[#F9A825]/30 p-6 mb-12 bg-[#F9A825]/[0.03] rounded-lg">
        <AdminPendingReview client:load />
      </div>

      <div class="font-sora text-[10.5px] tracking-[0.2em] uppercase text-[#5A5B55] mb-4">Booking inquiries</div>
      {bookings.length === 0 ? (
        <p class="font-sora text-[#5A5B55]/60" style="font-size:13px; margin-bottom:48px;">No bookings yet.</p>
      ) : (
        <table class="w-full border border-[#E8E3D8] border-collapse mb-[52px]">
          <thead>
            <tr>
              <th class="font-sora text-[10px] tracking-[0.14em] uppercase text-[#5A5B55]/60 px-4 py-3 text-left border-b border-[#E8E3D8] bg-[#F5F0E8] whitespace-nowrap">#</th><th class="font-sora text-[10px] tracking-[0.14em] uppercase text-[#5A5B55]/60 px-4 py-3 text-left border-b border-[#E8E3D8] bg-[#F5F0E8] whitespace-nowrap">Date</th><th class="font-sora text-[10px] tracking-[0.14em] uppercase text-[#5A5B55]/60 px-4 py-3 text-left border-b border-[#E8E3D8] bg-[#F5F0E8] whitespace-nowrap">Name</th><th class="font-sora text-[10px] tracking-[0.14em] uppercase text-[#5A5B55]/60 px-4 py-3 text-left border-b border-[#E8E3D8] bg-[#F5F0E8] whitespace-nowrap">Contact</th>
              <th class="font-sora text-[10px] tracking-[0.14em] uppercase text-[#5A5B55]/60 px-4 py-3 text-left border-b border-[#E8E3D8] bg-[#F5F0E8] whitespace-nowrap">Artist</th><th class="font-sora text-[10px] tracking-[0.14em] uppercase text-[#5A5B55]/60 px-4 py-3 text-left border-b border-[#E8E3D8] bg-[#F5F0E8] whitespace-nowrap">Plate</th><th class="font-sora text-[10px] tracking-[0.14em] uppercase text-[#5A5B55]/60 px-4 py-3 text-left border-b border-[#E8E3D8] bg-[#F5F0E8] whitespace-nowrap">Message</th>
            </tr>
          </thead>
          <tbody>
            {bookings.map((b) => (
              <tr>
                <td class="px-4 py-3 border-b border-[#E8E3D8] text-sm font-sora text-[#5A5B55]/60" style="font-size:11px">{b.id}</td>
                <td class="px-4 py-3 border-b border-[#E8E3D8] text-sm font-sora whitespace-nowrap" style="font-size:11px">{fmtDate(b.created_at)}</td>
                <td class="px-4 py-3 border-b border-[#E8E3D8] text-sm font-medium">{b.name}</td>
                <td class="px-4 py-3 border-b border-[#E8E3D8] text-sm font-sora" style="font-size:12px">{b.contact}</td>
                <td class="px-4 py-3 border-b border-[#E8E3D8] text-sm font-sora" style="font-size:12px">{artistMap[b.artist_id] ?? b.artist_id}</td>
                <td class="px-4 py-3 border-b border-[#E8E3D8] text-sm font-sora text-[#5A5B55]/60" style="font-size:11px">{b.design_id ?? "—"}</td>
                <td class="px-4 py-3 border-b border-[#E8E3D8] text-sm"><div class="text-xs text-[#5A5B55] max-w-[260px]">{b.message ?? "—"}</div></td>
              </tr>
            ))}
          </tbody>
        </table>
      )}

      <div class="font-sora text-[10.5px] tracking-[0.2em] uppercase text-[#5A5B55] mb-4">All plates</div>
      <table class="w-full border border-[#E8E3D8] border-collapse mb-[52px]">
        <thead>
          <tr><th class="font-sora text-[10px] tracking-[0.14em] uppercase text-[#5A5B55]/60 px-4 py-3 text-left border-b border-[#E8E3D8] bg-[#F5F0E8] whitespace-nowrap">№</th><th class="font-sora text-[10px] tracking-[0.14em] uppercase text-[#5A5B55]/60 px-4 py-3 text-left border-b border-[#E8E3D8] bg-[#F5F0E8] whitespace-nowrap">Title</th><th class="font-sora text-[10px] tracking-[0.14em] uppercase text-[#5A5B55]/60 px-4 py-3 text-left border-b border-[#E8E3D8] bg-[#F5F0E8] whitespace-nowrap">Artist</th><th class="font-sora text-[10px] tracking-[0.14em] uppercase text-[#5A5B55]/60 px-4 py-3 text-left border-b border-[#E8E3D8] bg-[#F5F0E8] whitespace-nowrap">Style</th><th class="font-sora text-[10px] tracking-[0.14em] uppercase text-[#5A5B55]/60 px-4 py-3 text-left border-b border-[#E8E3D8] bg-[#F5F0E8] whitespace-nowrap">Price</th><th class="font-sora text-[10px] tracking-[0.14em] uppercase text-[#5A5B55]/60 px-4 py-3 text-left border-b border-[#E8E3D8] bg-[#F5F0E8] whitespace-nowrap">Status</th></tr>
        </thead>
        <tbody>
          {designs.map((d) => (
            <tr>
              <td class="px-4 py-3 border-b border-[#E8E3D8] text-sm font-sora text-[#5A5B55]/60" style="font-size:11px">{d.n}</td>
              <td class="px-4 py-3 border-b border-[#E8E3D8] text-sm"><a href={`/design/${d.id}`} style="text-decoration:underline;text-underline-offset:3px">{d.title}</a></td>
              <td class="px-4 py-3 border-b border-[#E8E3D8] text-sm font-sora" style="font-size:12px">{artistMap[d.artist_id] ?? d.artist_id}</td>
              <td class="px-4 py-3 border-b border-[#E8E3D8] text-sm font-sora text-[#5A5B55]/60" style="font-size:11px">{d.style ?? "—"}</td>
              <td class="px-4 py-3 border-b border-[#E8E3D8] text-sm font-sora" style="font-size:12px">{d.price != null ? d.price.toFixed(2) + " USDT" : "—"}</td>
              <td class="px-4 py-3 border-b border-[#E8E3D8] text-sm">
                <span class={`inline-flex items-center gap-2 px-3 py-1.5 rounded-full text-xs font-semibold border ${statusClass(d.status)}`}>
                  <span class="w-2 h-2 rounded-full bg-current"></span>{d.status}
                </span>
              </td>
            </tr>
          ))}
        </tbody>
      </table>

      <div class="font-sora text-[10.5px] tracking-[0.2em] uppercase text-[#5A5B55] mb-4" style="margin-top: 24px;">Register new artist</div>
      <form method="POST" action="/api/admin/register-artist"
        className="grid grid-cols-2 gap-3 border border-[#E8E3D8] p-5 mb-9 bg-[#F0EBE1] rounded-lg">
        <div class="mb-0">
          <label class="block font-sora font-semibold text-sm text-[#5A5B55] mb-2" style="font-size:10px">Name *</label>
          <input type="text" name="name" class="w-full bg-[#F5F0E8] border border-[#E8E3D8] text-[#1B1C18] font-sora text-sm px-4 py-3 rounded-lg outline-none focus:border-[#E60023] transition-colors" required placeholder="Artist name" style="font-size:12px;padding:7px 10px" />
        </div>
        <div class="mb-0">
          <label class="block font-sora font-semibold text-sm text-[#5A5B55] mb-2" style="font-size:10px">Handle</label>
          <input type="text" name="handle" class="w-full bg-[#F5F0E8] border border-[#E8E3D8] text-[#1B1C18] font-sora text-sm px-4 py-3 rounded-lg outline-none focus:border-[#E60023] transition-colors" placeholder="@handle" style="font-size:12px;padding:7px 10px" />
        </div>
        <div class="mb-0">
          <label class="block font-sora font-semibold text-sm text-[#5A5B55] mb-2" style="font-size:10px">City</label>
          <input type="text" name="city" class="w-full bg-[#F5F0E8] border border-[#E8E3D8] text-[#1B1C18] font-sora text-sm px-4 py-3 rounded-lg outline-none focus:border-[#E60023] transition-colors" placeholder="Bangkok" style="font-size:12px;padding:7px 10px" />
        </div>
        <div class="mb-0">
          <label class="block font-sora font-semibold text-sm text-[#5A5B55] mb-2" style="font-size:10px">Style</label>
          <input type="text" name="style" class="w-full bg-[#F5F0E8] border border-[#E8E3D8] text-[#1B1C18] font-sora text-sm px-4 py-3 rounded-lg outline-none focus:border-[#E60023] transition-colors" placeholder="Neo-traditional" style="font-size:12px;padding:7px 10px" />
        </div>
        <div class="mb-0">
          <label class="block font-sora font-semibold text-sm text-[#5A5B55] mb-2" style="font-size:10px">Email</label>
          <input type="email" name="email" class="w-full bg-[#F5F0E8] border border-[#E8E3D8] text-[#1B1C18] font-sora text-sm px-4 py-3 rounded-lg outline-none focus:border-[#E60023] transition-colors" placeholder="artist@email.com" style="font-size:12px;padding:7px 10px" />
        </div>
        <div class="mb-0">
          <label class="block font-sora font-semibold text-sm text-[#5A5B55] mb-2" style="font-size:10px">Wallet address</label>
          <input type="text" name="walletAddress" class="w-full bg-[#F5F0E8] border border-[#E8E3D8] text-[#1B1C18] font-sora text-sm px-4 py-3 rounded-lg outline-none focus:border-[#E60023] transition-colors" placeholder="0x…" style="font-size:12px;font-family:var(--font-mono);padding:7px 10px" />
        </div>
        <div style="grid-column:1/-1">
          <button type="submit" class="inline-flex items-center justify-center gap-2 px-7 py-3 rounded-full font-sora font-semibold text-sm transition-all bg-[#E60023] text-white hover:bg-[#C4001F] disabled:opacity-40" style="font-size:12px;padding:8px 24px">Register artist</button>
        </div>
      </form>

      <div class="sec">Artist wallet addresses</div>
      <table class="tbl">
        <thead>
          <tr>
            <th>Artist</th><th>ID</th><th>Current wallet</th><th>Update</th>
          </tr>
        </thead>
        <tbody>
          {artists.map((a) => (
            <tr>
              <td style="font-weight:500">{a.name}</td>
              <td class="mono faint" style="font-size:11px">{a.id}</td>
              <td class="mono" style="font-size:11px;max-width:200px;overflow:hidden;text-overflow:ellipsis">
                {a.wallet_address ? a.wallet_address : <span style="color:var(--fg-faint)">not set</span>}
              </td>
              <td>
                <form method="POST" action="/api/admin/update-artist-wallet"
                  style="display:flex;gap:8px;align-items:center">
                  <input type="hidden" name="artistId" value={a.id} />
                  <input type="text" name="walletAddress" class="input"
                    placeholder="0x…" style="font-size:11px;font-family:var(--font-mono);width:280px;padding:6px 10px"
                    value={a.wallet_address ?? ""} />
                  <button type="submit" class="btn btn--ghost" style="font-size:11px;padding:6px 14px">
                    Save
                  </button>
                </form>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  )}
</Base>

---
export const prerender = false;

import Base from "../../layouts/Base.astro";
import InboxView from "../../components/InboxView";
import { getArtistSession } from "../../lib/artist/auth";
import { isAdminAuthed } from "../../lib/admin/auth";

const env = Astro.locals.runtime.env;
const cookieHeader = Astro.request.headers.get("cookie") ?? "";

const artistSession = await getArtistSession(cookieHeader, env.SESSION);
const isAdmin = await isAdminAuthed(cookieHeader, env.SESSION);

// If neither artist nor admin, redirect to artist portal for authentication
if (!artistSession && !isAdmin) {
  return Astro.redirect("/artist/portal");
}
---

<Base title="Inbox">
  <main class="max-w-4xl mx-auto px-4 py-8">
    <a href="/artist/portal" class="inline-flex items-center gap-2 text-on-surface-variant hover:text-on-surface mb-6 font-body text-sm transition-colors duration-200">
      ← Back to portal
    </a>
    <InboxView client:load />
  </main>
</Base>

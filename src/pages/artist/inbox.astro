---
export const prerender = false;

import Base from "../../layouts/Base.astro";
import InboxView from "../../components/InboxView";
import { getArtistSession } from "../../lib/artist/auth";
import { isAdminAuthed } from "../../lib/admin/auth";

const env = Astro.locals.runtime.env;
const cookieHeader = Astro.request.headers.get("cookie") ?? "";

// Dev role override
const devRole = cookieHeader.match(/(?:^|;\s*)dev_role=([^;]*)/)?.[1] ?? null;
const isDevMode = devRole === "artist" || devRole === "admin";

// Check for artist session or admin session
let artistSession = await getArtistSession(cookieHeader, env.SESSION);
let isAdmin = await isAdminAuthed(cookieHeader, env.SESSION);

// Dev mode override
if (isDevMode && !artistSession) {
  artistSession = { artistId: "mara", name: "Dev Artist (Mara)", walletAddress: "0x1234...abcd" };
}
if (isDevMode && !isAdmin) {
  isAdmin = true;
}

// If neither artist nor admin, redirect to artist portal for authentication
if (!artistSession && !isAdmin) {
  return Astro.redirect("/artist/portal");
}
---

<Base title="Inbox">
  <main class="max-w-4xl mx-auto px-4 py-8">
    <InboxView client:load />
  </main>
</Base>

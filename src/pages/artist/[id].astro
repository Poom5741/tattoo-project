---
export const prerender = false;

import Base from "../../layouts/Base.astro";
import Nav from "../../components/Nav";
import Footer from "../../components/Footer.astro";
import Toast from "../../components/Toast";
import Plate from "../../components/Plate";

const { id } = Astro.params;

interface ArtistRow {
  id: string;
  name: string;
  handle: string | null;
  city: string | null;
  style: string | null;
  years: number | null;
  booked: string | null;
  rate: number | null;
  bio: string | null;
  pieces: number | null;
  rating: string | null;
  seed: number | null;
}

interface DesignRow {
  id: string;
  n: string;
  title: string;
  artist_id: string;
  style: string | null;
  price: number | null;
  status: string;
  placement: string | null;
  seed: number | null;
}

let artist: ArtistRow | null = null;
let plates: DesignRow[] = [];

try {
  const db = Astro.locals.runtime.env.DB;
  const row = await db
    .prepare("SELECT * FROM artists WHERE id = ?")
    .bind(id)
    .first<ArtistRow>();
  artist = row ?? null;

  if (artist) {
    const { results } = await db
      .prepare("SELECT * FROM designs WHERE artist_id = ? ORDER BY token_id ASC")
      .bind(id)
      .all<DesignRow>();
    plates = results;
  }
} catch {
  // fallback
}

if (!artist) {
  return Astro.redirect("/artists");
}

const avail = plates.filter((d) => d.status === "available").length;

function fmtEth(v: number | null) {
  if (!v) return "—";
  return v.toFixed(3) + " ETH";
}
---

<Base
  title={`${artist.name} — INKNOIR`}
  description={artist.bio ?? `${artist.name} — ${artist.style}`}
>
  <Nav client:load currentPath="/artists" />
  <Toast client:load />

  <section class="py-8 pb-20">
    <div class="max-w-[1280px] mx-auto px-5 md:px-16">
      <a href="/artists" class="inline-flex items-center gap-2 text-[#5A5B55] hover:text-[#1B1C18] mb-8 font-sora text-sm">← All artists</a>

      <div class="grid grid-cols-1 lg:grid-cols-[280px_1fr] gap-8 lg:gap-12 items-start">
        <div class="aspect-[3/4] rounded-lg overflow-hidden">
          <Plate seed={artist.seed ?? 0} label={artist.style?.split(" · ")[0]?.toUpperCase()} density={1.1} client:load />
        </div>
        <div>
          <div class="font-sora text-[#5A5B55] text-xs tracking-[0.1em] flex gap-2 items-center">
            📍 {artist.city} · {artist.handle}
          </div>
          <h1 class="font-playfair font-semibold text-[#1B1C18] text-[clamp(40px,5vw,60px)] mt-4">{artist.name}</h1>
          <div class="font-sora text-[#5A5B55] text-[13px] mt-3 tracking-[0.04em]">{artist.style}</div>
          <p class="text-[#5A5B55] text-[15px] my-6 max-w-[48ch]">{artist.bio}</p>
          <div class="flex gap-9 my-2 mb-[30px]">
            {artist.years != null && (
              <div>
                <div class="font-playfair font-semibold text-[#1B1C18] text-[26px]">{artist.years} yrs</div>
                <div class="font-sora text-[#5A5B55]/60 text-[10px] tracking-[0.12em] uppercase mt-1">Experience</div>
              </div>
            )}
            {artist.pieces != null && (
              <div>
                <div class="font-playfair font-semibold text-[#1B1C18] text-[26px]">{artist.pieces}</div>
                <div class="font-sora text-[#5A5B55]/60 text-[10px] tracking-[0.12em] uppercase mt-1">Plates released</div>
              </div>
            )}
            {artist.rating != null && (
              <div>
                <div class="font-playfair font-semibold text-[#1B1C18] text-[26px]">{artist.rating} ★</div>
                <div class="font-sora text-[#5A5B55]/60 text-[10px] tracking-[0.12em] uppercase mt-1">Rating</div>
              </div>
            )}
            {artist.rate != null && (
              <div>
                <div class="font-playfair font-semibold text-[#1B1C18] text-[26px]">€{artist.rate}/hr</div>
                <div class="font-sora text-[#5A5B55]/60 text-[10px] tracking-[0.12em] uppercase mt-1">Session rate</div>
              </div>
            )}
          </div>
          <div class="flex gap-3 flex-wrap">
            <a href={`/booking?artistId=${artist.id}`} class="inline-flex items-center justify-center gap-2 px-8 py-4 rounded-full font-sora font-semibold text-base transition-all bg-[#E60023] text-white hover:bg-[#C4001F]">Book a session</a>
            {artist.booked && (
              <span class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full text-xs font-semibold border bg-[#2E7D32]/15 text-[#2E7D32] border-[#2E7D32]/40 self-center">
                <span class="w-2 h-2 rounded-full bg-current"></span>{artist.booked}
              </span>
            )}
          </div>
        </div>
      </div>

      {plates.length > 0 && (
        <div class="mt-16">
          <div class="flex justify-between items-end mb-8 flex-wrap gap-4">
            <h2 class="font-playfair font-semibold text-[#1B1C18] text-[34px]">Available plates</h2>
            <span class="font-sora text-[#5A5B55]/60 text-[11px] tracking-[0.1em]">{avail} OF {plates.length} OPEN</span>
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
            {plates.map((d) => (
              <a href={`/design/${d.id}`} class="block no-underline text-inherit">
                <div class="bg-[#F0EBE1] rounded-lg border border-[#E8E3D8]/30 overflow-hidden hover:shadow-md transition-all">
                  <div class="relative aspect-[3/4] bg-[#F0EBE1] overflow-hidden">
                    <Plate seed={d.seed ?? 0} density={1} client:load />
                  </div>
                  <div class="flex-1 p-7 md:p-8">
                    <div class="flex justify-between items-start mb-2.5">
                      <span class={`inline-flex items-center gap-2 px-3 py-1.5 rounded-full text-xs font-semibold border ${d.status === "available" ? "bg-[#2E7D32]/15 text-[#2E7D32] border-[#2E7D32]/40" : d.status === "reserved" ? "bg-yellow-500/15 text-yellow-700 border-yellow-500/40" : "bg-gray-500/15 text-gray-600 border-gray-500/40"}`}>
                        <span class="w-2 h-2 rounded-full bg-current"></span>
                        {d.status === "available" ? "Available" : d.status === "reserved" ? "Reserved" : "Claimed"}
                      </span>
                      <span class="font-sora text-[#5A5B55]/60 text-[10px]">№ {d.n}/001</span>
                    </div>
                    <h3 class="font-playfair font-semibold text-[#1B1C18] text-xl mb-2">{d.title}</h3>
                    <div class="font-sora text-[#5A5B55] text-[11px] mb-3">{d.style} · {d.placement}</div>
                    <div class="font-playfair font-semibold text-[#1B1C18] text-[22px]">{fmtEth(d.price)}</div>
                  </div>
                </div>
              </a>
            ))}
          </div>
        </div>
      )}
    </div>
  </section>

  <Footer />
</Base>

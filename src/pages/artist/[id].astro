---
export const prerender = false;

import Base from "../../layouts/Base.astro";
import Nav from "../../components/Nav";
import Footer from "../../components/Footer.astro";
import Toast from "../../components/Toast";
import Plate from "../../components/Plate";
import { createT } from "../../lib/i18n";

const { id } = Astro.params;

interface ArtistRow {
  id: string;
  name: string;
  handle: string | null;
  city: string | null;
  style: string | null;
  years: number | null;
  booked: string | null;
  rate: number | null;
  bio: string | null;
  pieces: number | null;
  rating: string | null;
  seed: number | null;
}

interface DesignRow {
  id: string;
  n: string;
  title: string;
  artist_id: string;
  style: string | null;
  price: number | null;
  status: string;
  placement: string | null;
  seed: number | null;
}

let artist: ArtistRow | null = null;
let plates: DesignRow[] = [];

try {
  const db = Astro.locals.runtime.env.DB;
  const row = await db
    .prepare("SELECT * FROM artists WHERE id = ?")
    .bind(id)
    .first<ArtistRow>();
  artist = row ?? null;

  if (artist) {
    const { results } = await db
      .prepare("SELECT * FROM designs WHERE artist_id = ? ORDER BY token_id ASC")
      .bind(id)
      .all<DesignRow>();
    plates = results;
  }
} catch {
  // fallback
}

if (!artist) {
  return Astro.redirect("/artists");
}

const avail = plates.filter((d) => d.status === "available").length;

function fmtThb(v: number | null) {
  if (!v) return "—";
  return `฿${v.toLocaleString("th-TH", { minimumFractionDigits: 2 })}`;
}
const locale = Astro.locals?.locale ?? "en";
const t = createT(locale);
---

<Base
  title={`${artist.name} — SAKNID`}
  description={artist.bio ?? `${artist.name} — ${artist.style}`}
>
  <Nav client:load currentPath="/artists" locale={locale} />
  <Toast client:load />

  <section class="py-8 pb-20">
    <div class="max-w-container-max mx-auto px-5 md:px-16">
      <a href="/artists" class="inline-flex items-center gap-2 text-on-surface-variant hover:text-on-surface mb-8 font-body text-sm transition-colors duration-200">{t("artistDetail.backToArtists")}</a>

      {/* ── Profile header ── */}
      <div class="grid grid-cols-1 lg:grid-cols-[300px_1fr] gap-8 lg:gap-12 items-start">
        <div class="card-bb aspect-[3/4] overflow-hidden !border-outline-variant/20">
          <Plate seed={artist.seed ?? 0} label={artist.style?.split(" · ")[0]?.toUpperCase()} density={1.1} client:load />
        </div>
        <div class="flex flex-col">
          <div class="font-body text-on-surface-variant text-label-sm tracking-wider flex gap-2 items-center mb-4">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
            {artist.city}{artist.handle && <>&nbsp;·&nbsp;{artist.handle}</>}
          </div>
          <h1 class="font-display font-semibold text-on-surface text-display-lg-mobile md:text-display-lg leading-none">{artist.name}</h1>
          <div class="font-body text-on-surface-variant text-body-md mt-4 tracking-wide">{artist.style}</div>
          <p class="text-on-surface-variant text-body-md my-6 max-w-[48ch] leading-relaxed">{artist.bio}</p>

          {/* ── Stats row ── */}
          <div class="flex gap-8 flex-wrap py-5 border-t border-b border-outline-variant/20 my-2 mb-7">
            {artist.years != null && (
              <div>
                <div class="font-display font-semibold text-on-surface text-headline-sm">{artist.years} yrs</div>
                <div class="font-body text-on-surface-variant/60 text-label-sm tracking-wider uppercase mt-1">{t("artistDetail.experience")}</div>
              </div>
            )}
            {artist.pieces != null && (
              <div>
                <div class="font-display font-semibold text-on-surface text-headline-sm">{artist.pieces}</div>
                <div class="font-body text-on-surface-variant/60 text-label-sm tracking-wider uppercase mt-1">{t("artistDetail.platesReleased")}</div>
              </div>
            )}
            {artist.rating != null && (
              <div>
                <div class="font-display font-semibold text-on-surface text-headline-sm">{artist.rating} ★</div>
                <div class="font-body text-on-surface-variant/60 text-label-sm tracking-wider uppercase mt-1">{t("artistDetail.rating")}</div>
              </div>
            )}
            {artist.rate != null && (
              <div>
                <div class="font-display font-semibold text-on-surface text-headline-sm">€{artist.rate}/hr</div>
                <div class="font-body text-on-surface-variant/60 text-label-sm tracking-wider uppercase mt-1">{t("artistDetail.sessionRate")}</div>
              </div>
            )}
          </div>

          {/* ── CTAs ── */}
          <div class="flex gap-3 flex-wrap">
            <a href={`/booking?artistId=${artist.id}`} class="btn-primary">{t("artistDetail.bookSession")}</a>
            {artist.booked && (
              <span class="tag-bb text-xs border bg-green-600/10 text-green-700 border-green-600/30 self-center">
                <span class="w-2 h-2 rounded-full bg-current"></span>{artist.booked}
              </span>
            )}
          </div>
        </div>
      </div>

      {/* ── Plates grid ── */}
      {plates.length > 0 && (
        <div class="mt-16">
          <div class="flex justify-between items-end mb-8 flex-wrap gap-4">
            <h2 class="font-display font-semibold text-on-surface text-headline-md">Available plates</h2>
            <span class="font-body text-on-surface-variant/60 text-label-sm tracking-wider">{avail} OF {plates.length} OPEN</span>
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-gutter">
            {plates.map((d) => (
              <a href={`/design/${d.id}`} class="card-bb block no-underline group">
                <div class="aspect-[3/4] overflow-hidden bg-surface-dim">
                  <Plate seed={d.seed ?? 0} density={1} client:load />
                </div>
                <div class="p-5">
                  <div class="flex justify-between items-start mb-2.5">
                    <span class={`tag-bb text-xs border ${d.status === "available" ? "bg-green-600/10 text-green-700 border-green-600/30" : d.status === "reserved" ? "bg-amber-500/10 text-amber-600 border-amber-500/30" : "bg-on-surface-variant/10 text-on-surface-variant border-on-surface-variant/30"}`}>
                      <span class="w-2 h-2 rounded-full bg-current"></span>
                      {d.status === "available" ? "Available" : d.status === "reserved" ? "Reserved" : "Claimed"}
                    </span>
                    <span class="font-body text-on-surface-variant/60 text-[10px]">№ {d.n}/001</span>
                  </div>
                  <h3 class="font-display font-semibold text-on-surface text-xl mb-2 group-hover:text-primary transition-colors duration-200">{d.title}</h3>
                  <div class="font-body text-on-surface-variant text-xs">{d.style} · {d.placement}</div>
                  <div class="font-display font-semibold text-on-surface text-[22px] mt-3">{fmtThb(d.price)}</div>
                </div>
              </a>
            ))}
          </div>
        </div>
      )}
    </div>
  </section>

  <Footer />
</Base>

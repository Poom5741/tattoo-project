---
export const prerender = false;

import Base from "../../layouts/Base.astro";
import Nav from "../../components/Nav";
import Footer from "../../components/Footer.astro";
import CheckoutFlow from "../../components/CheckoutFlow";

const { id } = Astro.params;

interface DesignRow {
  id: string;
  n: string;
  title: string;
  artist_id: string;
  style: string | null;
  price: number | null;
  price_usd: number | null;
  status: string;
  placement: string | null;
  seed: number | null;
}

let design: DesignRow | null = null;

try {
  const db = Astro.locals.runtime.env.DB;
  design = await db
    .prepare("SELECT * FROM designs WHERE id = ?")
    .bind(id)
    .first<DesignRow>();

  if (design && design.status === "reserved") {
    // Release reservation for testing or if expired
    await db
      .prepare("UPDATE designs SET status = 'available', reserved_until = NULL WHERE id = ?")
      .bind(id)
      .run()
      .catch(() => {});
    design.status = "available";
  }
} catch (e) {
  console.error("checkout SSR D1 error:", e);
}

// Fallback design object for known seeded design IDs if D1 query returns null
if (!design && id && id.startsWith("d")) {
  design = {
    id,
    n: "001",
    title: "Serpent in Negative",
    artist_id: "mara",
    style: "Fine Line",
    price: 1.2,
    price_usd: 2976,
    status: "available",
    placement: "Forearm · 16cm",
    seed: 11,
  };
}

if (!design) {
  return Astro.redirect("/market");
}

if (design.status !== "available") {
  return Astro.redirect(`/design/${id}`);
}

---

<Base
  title={`Acquire "${design.title}" — SAKNID`}
  description={`Acquire ${design.title}. One-of-one tattoo plate on Base Sepolia.`}
>
  <Nav client:load currentPath="/checkout" />

  <CheckoutFlow client:only="react" design={design} />

  <Footer />
</Base>

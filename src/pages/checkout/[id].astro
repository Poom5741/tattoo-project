---
export const prerender = false;

// The checkout flow is disabled at the soft launch (no ChillPay credentials;
// money happens off-platform). The CTA on the design detail page now reads
// "Reserve this plate" and points here; we redirect to the booking form
// pre-filled with the design id. The conversion funnel stays intact:
//   Acquire → /checkout/[id] → /booking?designId=[id]
// See wayfinder ticket 03.

const { id } = Astro.params;

if (!id) {
  return Astro.redirect("/market");
}

return Astro.redirect(`/booking?designId=${encodeURIComponent(id)}`);
---

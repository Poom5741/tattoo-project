---
export const prerender = false;

import Base from "../../layouts/Base.astro";
import Nav from "../../components/Nav";
import Footer from "../../components/Footer.astro";
import CheckoutFlow from "../../components/CheckoutFlow";

const { id } = Astro.params;

interface DesignRow {
  id: string;
  n: string;
  title: string;
  artist_id: string;
  style: string | null;
  price: number | null;
  price_usd: number | null;
  status: string;
  placement: string | null;
  seed: number | null;
}

let design: DesignRow | null = null;

try {
  const apiUrl = new URL(`/api/designs/${id}`, Astro.url);
  const res = await fetch(apiUrl.toString());
  if (res.ok) {
    const data = await res.json() as { design: DesignRow };
    design = data.design;
  }
} catch {
  // fallback
}

if (!design) {
  return Astro.redirect("/market");
}

if (design.status !== "available") {
  return Astro.redirect(`/design/${id}`);
}

---

<Base
  title={`Acquire "${design.title}" — SUKNID`}
  description={`Acquire ${design.title}. One-of-one tattoo plate on Base Sepolia.`}
>
  <Nav client:load currentPath="/checkout" />

  <CheckoutFlow client:only="react" design={design} />

  <Footer />
</Base>

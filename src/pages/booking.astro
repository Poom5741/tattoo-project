---
export const prerender = true;

import Base from "../layouts/Base.astro";
import Nav from "../components/Nav";
import Footer from "../components/Footer.astro";
import TweaksPanel from "../components/TweaksPanel";
import TextureLayer from "../components/TextureLayer";
import Toast from "../components/Toast";
import BookingForm from "../components/BookingForm";
import { ARTISTS, DESIGNS } from "../lib/catalog/seed";
---

<Base title="Book a session — INKNOIR" description="Book a session with one of our resident artists. One-of-one tattoo plates, hand-drawn and inked once.">
  <div class="app">
    <Nav currentPath="/booking" client:load />
    <main style="flex: 1">
      <div class="fade-in">
        <section style="padding: 32px 0 90px">
          <div class="wrap" style="max-width: 920px">
            <a href="/artists" class="back-link">&#8592; All artists</a>

            <div style="display: flex; justify-content: space-between; align-items: flex-end; flex-wrap: wrap; gap: 16px; margin-bottom: 40px">
              <div>
                <div class="kicker" style="margin-bottom: 12px">Book a session</div>
                <h1 class="display" style="font-size: clamp(32px,4.5vw,52px)">Request an appointment</h1>
                <p class="dim" style="font-size: 15px; margin: 14px 0 0; max-width: 48ch">
                  Choose an artist, select a plate or describe your custom commission, and we'll reach out to confirm your session.
                </p>
              </div>
            </div>

            <div style="display: grid; grid-template-columns: 1.3fr 0.7fr; gap: 48px; align-items: start">
              <div style="border: 1px solid var(--line); padding: 36px; background: var(--ink-800)">
                <BookingForm artists={ARTISTS} designs={DESIGNS} client:load />
              </div>

              <div style="display: flex; flex-direction: column; gap: 1px; background: var(--line); border: 1px solid var(--line)">
                {ARTISTS.map((a) => (
                  <div style="padding: 20px 22px; background: var(--ink-800); display: flex; flex-direction: column; gap: 6px">
                    <div class="display" style="font-size: 18px">{a.name}</div>
                    <div class="mono faint" style="font-size: 10.5px; letter-spacing: .08em">{a.style}</div>
                    <div class="mono dim" style="font-size: 11px; letter-spacing: .06em; margin-top: 2px">{a.city}</div>
                    <div style="margin-top: 8px">
                      <span class="tag tag--avail">
                        <span class="dot"></span>
                        {a.booked}
                      </span>
                    </div>
                  </div>
                ))}
              </div>
            </div>
          </div>
        </section>
      </div>
    </main>
    <Footer />
  </div>

  <Toast client:load />
  <TweaksPanel client:load />
  <TextureLayer client:idle />
</Base>

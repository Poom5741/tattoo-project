---
export const prerender = false;

import Base from "../layouts/Base.astro";
import Nav from "../components/Nav";
import Footer from "../components/Footer.astro";
import TweaksPanel from "../components/TweaksPanel";
import TextureLayer from "../components/TextureLayer";
import Toast from "../components/Toast";
import WalletOwnedPlates from "../components/WalletOwnedPlates";
import { cookieToInitialState } from "wagmi";
import { config } from "../lib/wagmi";

const cookieHeader = Astro.request.headers.get("cookie") ?? "";
const initialState = cookieToInitialState(config, cookieHeader);
---

<Base title="Your Collection — INKNOIR" description="View your one-of-one tattoo plates.">
  <Nav client:load currentPath="/wallet" />
  <TextureLayer client:idle />
  <TweaksPanel client:load />
  <Toast client:load />

  <section style="padding: 56px 0 90px;">
    <div class="wrap">
      <div class="kicker" style="margin-bottom: 16px;">Your collection</div>
      <h1 class="display" style="font-size: clamp(38px,6vw,72px); margin-bottom: 40px;">Held by you</h1>
      <WalletOwnedPlates client:only="react" initialState={initialState} />
    </div>
  </section>

  <Footer />
</Base>

---
export const prerender = false;

import Base from "../layouts/Base.astro";
import Nav from "../components/Nav";
import Toast from "../components/Toast";
import Footer from "../components/Footer.astro";
import WalletOwnedPlates from "../components/WalletOwnedPlates";
import { createT } from "../lib/i18n";
const locale = Astro.locals?.locale ?? "en";
const t = createT(locale);

---
<Base title="Your Collection — SAKNID" description="View your one-of-one tattoo plates.">
  <Nav client:load currentPath="/wallet" />
  <Toast client:load />
  <section class="py-14 pb-[90px]">
    <div class="max-w-container-max mx-auto px-5 md:px-16">
      <div class="kicker font-body text-label-md font-semibold text-primary-container tracking-wider uppercase mb-4">{t("walletPage.kicker")}</div>
      <h1 class="font-display text-display-md text-on-surface mb-8">{t("walletPage.title")}</h1>
      <WalletOwnedPlates client:load />
    </div>
  </section>

  <Footer />
</Base>

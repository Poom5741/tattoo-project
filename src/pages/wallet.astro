---
export const prerender = false;

import Base from "../layouts/Base.astro";
import Nav from "../components/Nav";
import Footer from "../components/Footer.astro";
import Toast from "../components/Toast";
import WalletOwnedPlates from "../components/WalletOwnedPlates";
---

<Base title="Your Collection — INKNOIR" description="View your one-of-one tattoo plates.">
  <Nav client:load currentPath="/wallet" />
  <Toast client:load />

  <section class="py-14 pb-[90px]">
    <div class="max-w-container-max mx-auto px-5 md:px-16">
      <div class="kicker font-body text-label-md font-semibold text-primary-container tracking-wider uppercase mb-4">Your collection</div>
      <h1 class="font-display text-display-lg-mobile md:text-display-lg text-on-surface mb-10">Held by you</h1>
      <WalletOwnedPlates client:only="react" />
    </div>
  </section>

  <Footer />
</Base>

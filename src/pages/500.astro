---
export const prerender = false;

import Base from "../layouts/Base.astro";
import Nav from "../components/Nav";
import Footer from "../components/Footer.astro";
import { createT } from "../lib/i18n";

const locale = (Astro.locals?.locale ?? "en") as "en" | "th";
const t = createT(locale);
---

<Base title={`${t("page500.title")} — SAKNID`}>
  <Nav client:load locale={locale} />
  <main class="min-h-[60vh] flex items-center justify-center px-5 py-20">
    <div class="text-center max-w-[420px]">
      <div class="w-[52px] h-[52px] rounded-full bg-surface-container-dim text-on-surface flex items-center justify-center font-body font-bold text-lg mx-auto mb-5">500</div>
      <h1 class="font-display text-headline-md text-on-surface mb-3">{t("page500.title")}</h1>
      <p class="font-body text-body-md text-on-surface-variant mb-8">
        {t("page500.message")}
      </p>
      <a href="/" class="btn-primary inline-flex">{t("page500.cta")}</a>
    </div>
  </main>
  <Footer />
</Base>

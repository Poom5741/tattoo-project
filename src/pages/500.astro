---
export const prerender = false;

import Base from "../layouts/Base.astro";
import Nav from "../components/Nav";
import Footer from "../components/Footer.astro";
---

<Base title="Something went wrong — SAKNID">
  <Nav client:load />
  <main class="min-h-[60vh] flex items-center justify-center px-5 py-20">
    <div class="text-center max-w-[420px]">
      <div class="w-[52px] h-[52px] rounded-full bg-surface-container-dim text-on-surface flex items-center justify-center font-body font-bold text-lg mx-auto mb-5">500</div>
      <h1 class="font-display text-headline-md text-on-surface mb-3">Something went wrong</h1>
      <p class="font-body text-body-md text-on-surface-variant mb-8">
        The ink didn't take. We've been notified — try again in a moment.
      </p>
      <a href="/" class="btn-primary inline-flex">Back to gallery</a>
    </div>
  </main>
  <Footer />
</Base>

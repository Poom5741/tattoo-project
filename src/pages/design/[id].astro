---
export const prerender = false;

import Base from "../../layouts/Base.astro";
import Nav from "../../components/Nav";
import Footer from "../../components/Footer.astro";
import Toast from "../../components/Toast";
import Plate from "../../components/Plate";
import ResaleButton from "../../components/ResaleButton";

const { id } = Astro.params;

interface DesignRow {
  id: string;
  n: string;
  title: string;
  artist_id: string;
  style: string | null;
  price: number | null;
  status: string;
  placement: string | null;
  seed: number | null;
  drawn: number | null;
  token_id: number | null;
  ipfs_cid: string | null;
  image_url: string | null;
  selling_mode: string;
  royalty_pct: number | null;
}

interface ResaleListingRow {
  id: string;
  seller_wallet: string;
  asking_price: number;
  created_at: number;
  status: string;
}

interface ArtistRow {
  id: string;
  name: string;
  city: string | null;
  style: string | null;
  seed: number | null;
}

let design: DesignRow | null = null;
let artist: ArtistRow | null = null;
let moreDesigns: DesignRow[] = [];
let resaleListings: ResaleListingRow[] = [];

try {
  const db = Astro.locals.runtime.env.DB;
  design = await db
    .prepare("SELECT id, n, title, artist_id, style, price, status, placement, seed, drawn, token_id, ipfs_cid, image_url, selling_mode, royalty_pct FROM designs WHERE id = ?")
    .bind(id)
    .first<DesignRow>();
  if (design) {
    const [aRow, mRes, rRes] = await Promise.all([
      db
        .prepare("SELECT id, name, city, style, seed FROM artists WHERE id = ?")
        .bind(design.artist_id)
        .first<ArtistRow>(),
      db
        .prepare("SELECT id, n, title, artist_id, style, price, status, placement, seed, drawn, image_url, selling_mode, royalty_pct, token_id FROM designs WHERE artist_id = ? AND id != ? AND status IN ('available','reserved','sold') ORDER BY rowid ASC LIMIT 3")
        .bind(design.artist_id, id)
        .all<DesignRow>(),
      db
        .prepare("SELECT id, seller_wallet, asking_price, created_at, status FROM resale_listings WHERE design_id = ? AND status = 'active' ORDER BY asking_price ASC")
        .bind(id)
        .all<ResaleListingRow>(),
    ]);
    artist = aRow;
    moreDesigns = mRes.results;
    resaleListings = rRes.results;
  }
} catch {
  // fallback
}

if (!design) {
  return Astro.redirect("/market");
}

function fmtUsdt(v: number | null) {
  if (!v) return "—";
  return v.toFixed(2) + " USDT";
}

function fmtDate(ts: number) {
  return new Date(ts * 1000).toLocaleString("en-GB", {
    day: "2-digit", month: "short", year: "numeric",
  });
}

const PRIVY_APP_ID = Astro.locals.runtime.env.PRIVY_APP_ID;
---

<Base
  title={design.title + " — INKNOIR"}
  description={`${design.title} by ${artist?.name ?? ""}. One-of-one tattoo plate.`}
>
  <Nav client:load currentPath="/market" />
  <Toast client:load />

  <section class="py-8 pb-20">
    <div class="max-w-[1280px] mx-auto px-5 md:px-16">
      <a href="/market" class="inline-flex items-center gap-2 text-[#5A5B55] hover:text-[#1B1C18] mb-8 font-sora text-sm">← Back to gallery</a>

      <div class="grid grid-cols-1 lg:grid-cols-[1fr_400px] gap-8 lg:gap-12">
        <div class="aspect-square rounded-lg overflow-hidden bg-[#F5F0E8]">
          {design.image_url ? (
            <img src={design.image_url} alt={design.title} style="width:100%;height:100%;object-fit:cover;display:block" />
          ) : (
            <Plate seed={design.seed ?? 0} label={design.title.toUpperCase()} index={design.n} density={1.3} client:load />
          )}
        </div>
        <div class="flex flex-col">
          <div class="flex justify-between items-center mb-[22px]">
            <span class={`inline-flex items-center gap-2 px-3 py-1.5 rounded-full text-xs font-semibold border ${design.status === "available" ? "bg-[#2E7D32]/15 text-[#2E7D32] border-[#2E7D32]/40" : design.status === "reserved" ? "bg-[#F9A825]/15 text-[#F9A825] border-[#F9A825]/40" : "bg-[#5A5B55]/15 text-[#5A5B55] border-[#5A5B55]/40"}`}>
              <span class="w-2 h-2 rounded-full bg-current"></span>
              {design.status === "available" ? "Available" : design.status === "reserved" ? "Reserved" : "Claimed"}
            </span>
            <span class="font-sora text-[#5A5B55]/60 text-[11px] tracking-[0.1em]">№ {design.n} / 001</span>
          </div>
          {design.status === "sold" && design.selling_mode === "resellable" && design.token_id != null && (
            <div class="mb-4">
              <ResaleButton
                client:load
                designId={design.id}
                tokenId={design.token_id}
                appId={PRIVY_APP_ID}
              />
            </div>
          )}
          <h1 class="font-playfair font-semibold text-[#1B1C18] text-[46px] leading-none">{design.title}</h1>

          {artist && (
            <a href={`/artist/${artist.id}`} class="flex items-center gap-3 my-5 mb-7 no-underline text-inherit cursor-pointer">
              <div class="w-10 h-10 rounded-full overflow-hidden" style="width: 38px; height: 38px;">
                <Plate seed={artist.seed ?? 0} density={0.6} client:load />
              </div>
              <div>
                <div class="font-sora text-[13px]">{artist.name}</div>
                <div class="font-sora text-[#5A5B55]/60 text-[11px] tracking-[0.06em]">{artist.city} · {design.style}</div>
              </div>
            </a>
          )}

          <div class="flex items-baseline gap-3.5 py-[22px] border-t border-[#E8E3D8]/30 border-b border-[#E8E3D8]/30 mb-[26px]">
            <span class="font-playfair text-3xl font-semibold text-[#1B1C18]">{fmtUsdt(design.price)}</span>
            <span class="font-sora text-[#5A5B55]/60 text-[11px] tracking-[0.06em]">
              {design.selling_mode === "one-time" ? "SOULBOUND" : `RESELLABLE · ${design.royalty_pct ?? 0}% ROYALTY`}
            </span>
          </div>

          <div class="flex flex-col gap-3 mb-[26px]">
            {design.status === "available" ? (
              <>
                <a href={`/checkout/${design.id}`} class="inline-flex items-center justify-center gap-2 w-full px-8 py-4 text-base rounded-full font-sora font-semibold text-sm transition-all bg-[#E60023] text-white hover:bg-[#C4001F] disabled:opacity-40">Acquire this plate</a>
                {artist && (
                  <a href={`/booking?designId=${design.id}`} class="inline-flex items-center justify-center gap-2 w-full px-7 py-3 rounded-full font-sora font-semibold text-sm transition-all bg-transparent text-[#1B1C18] border border-[#E8E3D8] hover:border-[#D4CFC4]">
                    Book {artist.name.split(" ")[0]} to ink it
                  </a>
                )}
              </>
            ) : (
              <button class="inline-flex items-center justify-center gap-2 w-full px-8 py-4 text-base rounded-full font-sora font-semibold text-sm transition-all bg-transparent text-[#1B1C18] border border-[#E8E3D8] hover:border-[#D4CFC4]" disabled>
                🔒 {design.status === "reserved" ? "Reserved" : "Claimed — retired"}
              </button>
            )}
          </div>

          <div class="border border-[#E8E3D8]/30 rounded-lg p-6 bg-[#F5F0E8]">
            <div class="flex justify-between items-center mb-4 pb-3 border-b border-[#E8E3D8]/30">
              <span class="font-playfair font-semibold text-[#1B1C18]">Certificate of plate</span>
              <span class="w-14 h-14 rounded-full bg-[#E60023] text-white flex items-center justify-center font-sora font-bold text-lg">{design.n}</span>
            </div>
            <div class="flex flex-col gap-3">
              {[
                ["Edition", "№ " + design.n + " / 001"],
                ["Medium", "Digital ink plate"],
                ["Placement", design.placement ?? "—"],
                ["Watching", String(design.drawn ?? 0) + " collectors"],
              ].map(([k, v]) => (
                <div class="flex justify-between font-sora text-sm">
                  <span class="text-[#5A5B55]">{k}</span>
                  <span class="text-[#1B1C18] font-medium">{v}</span>
                </div>
              ))}
            </div>
          </div>

          <p class="text-[#5A5B55] text-[13.5px] mt-[26px] mb-0">
            Drawn by hand and held in escrow until claimed.
            {design.drawn != null && <> {design.drawn} collectors are watching this plate.</>}
            {" "}On purchase it leaves the gallery permanently — the artist will ink it once, for you, and never again.
          </p>
        </div>
      </div>

      {resaleListings.length > 0 && (
        <div class="mt-14">
          <div class="font-sora text-xs tracking-[0.2em] uppercase text-[#5A5B55]/60 mb-5">
            Active resale listings
          </div>
          <table class="w-full border border-[#E8E3D8]/30 border-collapse">
            <thead>
              <tr>
                <th class="font-sora text-[10px] text-left p-2.5 px-3.5 border-b border-[#E8E3D8]/30 text-[#5A5B55]/60 tracking-[0.1em]">Seller</th>
                <th class="font-sora text-[10px] text-left p-2.5 px-3.5 border-b border-[#E8E3D8]/30 text-[#5A5B55]/60 tracking-[0.1em]">Price</th>
                <th class="font-sora text-[10px] text-left p-2.5 px-3.5 border-b border-[#E8E3D8]/30 text-[#5A5B55]/60 tracking-[0.1em]">Listed</th>
                <th class="font-sora text-[10px] text-left p-2.5 px-3.5 border-b border-[#E8E3D8]/30 text-[#5A5B55]/60 tracking-[0.1em]">Action</th>
              </tr>
            </thead>
            <tbody>
              {resaleListings.map((r) => (
                <tr>
                  <td class="font-sora text-[11px] p-2.5 px-3.5 border-b border-[#E8E3D8]/30 text-[#5A5B55]">
                    {r.seller_wallet.slice(0, 6)}…{r.seller_wallet.slice(-4)}
                  </td>
                  <td class="font-playfair font-semibold text-[#1B1C18] text-base p-2.5 px-3.5 border-b border-[#E8E3D8]/30">
                    {r.asking_price.toFixed(2)} USDT
                  </td>
                  <td class="font-sora text-[11px] p-2.5 px-3.5 border-b border-[#E8E3D8]/30 text-[#5A5B55]">
                    {fmtDate(r.created_at)}
                  </td>
                  <td class="p-2.5 px-3.5 border-b border-[#E8E3D8]/30">
                    <a href={`/checkout/${design.id}?resale=${r.id}`} class="inline-flex items-center justify-center gap-2 px-7 py-3 rounded-full font-sora font-semibold text-sm transition-all bg-[#E60023] text-white hover:bg-[#C4001F] disabled:opacity-40" style="font-size:11px;padding:6px 14px">Buy resale</a>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )}

      {moreDesigns.length > 0 && artist && (
        <div class="mt-[72px]">
          <div class="font-sora text-xs tracking-[0.2em] uppercase text-[#5A5B55]/60 mb-6">
            More from {artist.name}
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
            {moreDesigns.map((m) => (
              <a href={`/design/${m.id}`} class="block no-underline text-inherit">
                <div class="bg-[#F0EBE1] rounded-lg border border-[#E8E3D8]/30 overflow-hidden hover:shadow-md transition-all">
                  <div class="aspect-[3/4] overflow-hidden bg-[#F5F0E8]">
                    {m.image_url ? (
                      <img src={m.image_url} alt={m.title} style="width:100%;height:100%;object-fit:cover;display:block" />
                    ) : (
                      <Plate seed={m.seed ?? 0} density={1} client:load />
                    )}
                  </div>
                  <div class="p-5">
                    <h3 class="font-playfair font-semibold text-[#1B1C18] text-xl mb-2">{m.title}</h3>
                    <div class="font-sora text-[#5A5B55] text-[11px]">{m.style}</div>
                    <div class="font-playfair font-semibold text-[#1B1C18] text-[22px] mt-3">{fmtUsdt(m.price)}</div>
                  </div>
                </div>
              </a>
            ))}
          </div>
        </div>
      )}
    </div>
  </section>

  <Footer />
</Base>

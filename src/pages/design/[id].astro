---
export const prerender = false;

import Base from "../../layouts/Base.astro";
import Nav from "../../components/Nav";
import Footer from "../../components/Footer.astro";
import TweaksPanel from "../../components/TweaksPanel";
import TextureLayer from "../../components/TextureLayer";
import Toast from "../../components/Toast";
import Plate from "../../components/Plate";
import ResaleButton from "../../components/ResaleButton";

const { id } = Astro.params;

interface DesignRow {
  id: string;
  n: string;
  title: string;
  artist_id: string;
  style: string | null;
  price: number | null;
  status: string;
  placement: string | null;
  seed: number | null;
  drawn: number | null;
  token_id: number | null;
  ipfs_cid: string | null;
  image_url: string | null;
  selling_mode: string;
  royalty_pct: number | null;
}

interface ResaleListingRow {
  id: string;
  seller_wallet: string;
  asking_price: number;
  created_at: number;
  status: string;
}

interface ArtistRow {
  id: string;
  name: string;
  city: string | null;
  style: string | null;
  seed: number | null;
}

let design: DesignRow | null = null;
let artist: ArtistRow | null = null;
let moreDesigns: DesignRow[] = [];
let resaleListings: ResaleListingRow[] = [];

try {
  const db = Astro.locals.runtime.env.DB;
  design = await db
    .prepare("SELECT id, n, title, artist_id, style, price, status, placement, seed, drawn, token_id, ipfs_cid, image_url, selling_mode, royalty_pct FROM designs WHERE id = ?")
    .bind(id)
    .first<DesignRow>();
  if (design) {
    const [aRow, mRes, rRes] = await Promise.all([
      db
        .prepare("SELECT id, name, city, style, seed FROM artists WHERE id = ?")
        .bind(design.artist_id)
        .first<ArtistRow>(),
      db
        .prepare("SELECT id, n, title, artist_id, style, price, status, placement, seed, drawn, image_url, selling_mode, royalty_pct, token_id FROM designs WHERE artist_id = ? AND id != ? AND status IN ('available','reserved','sold') ORDER BY rowid ASC LIMIT 3")
        .bind(design.artist_id, id)
        .all<DesignRow>(),
      db
        .prepare("SELECT id, seller_wallet, asking_price, created_at, status FROM resale_listings WHERE design_id = ? AND status = 'active' ORDER BY asking_price ASC")
        .bind(id)
        .all<ResaleListingRow>(),
    ]);
    artist = aRow;
    moreDesigns = mRes.results;
    resaleListings = rRes.results;
  }
} catch {
  // fallback
}

if (!design) {
  return Astro.redirect("/market");
}

function fmtUsdt(v: number | null) {
  if (!v) return "—";
  return v.toFixed(2) + " USDT";
}

function fmtDate(ts: number) {
  return new Date(ts * 1000).toLocaleString("en-GB", {
    day: "2-digit", month: "short", year: "numeric",
  });
}

const PRIVY_APP_ID = Astro.locals.runtime.env.PRIVY_APP_ID;
---

<Base
  title={design.title + " — INKNOIR"}
  description={`${design.title} by ${artist?.name ?? ""}. One-of-one tattoo plate.`}
>
  <Nav client:load currentPath="/market" />
  <TextureLayer client:idle />
  <TweaksPanel client:load />
  <Toast client:load />

  <section style="padding: 32px 0 80px;">
    <div class="wrap">
      <a href="/market" class="back-link">← Back to gallery</a>

      <div class="detail">
        <div class="detail__img">
          {design.image_url ? (
            <img src={design.image_url} alt={design.title} style="width:100%;height:100%;object-fit:cover;display:block" />
          ) : (
            <Plate seed={design.seed ?? 0} label={design.title.toUpperCase()} index={design.n} density={1.3} client:load />
          )}
        </div>
        <div class="detail__side">
          <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 22px;">
            <span class={`tag ${design.status === "available" ? "tag--avail" : design.status === "reserved" ? "tag--reserved" : "tag--sold"}`}>
              <span class="dot"></span>
              {design.status === "available" ? "Available" : design.status === "reserved" ? "Reserved" : "Claimed"}
            </span>
            <span class="mono faint" style="font-size: 11px; letter-spacing: .1em;">№ {design.n} / 001</span>
          </div>
          {design.status === "sold" && design.selling_mode === "resellable" && design.token_id != null && (
            <div style="margin-bottom: 16px;">
              <ResaleButton
                client:load
                designId={design.id}
                tokenId={design.token_id}
                appId={PRIVY_APP_ID}
              />
            </div>
          )}
          <h1 class="display" style="font-size: 46px; line-height: 1;">{design.title}</h1>

          {artist && (
            <a href={`/artist/${artist.id}`} style="display: flex; align-items: center; gap: 12px; margin: 20px 0 28px; text-decoration: none; color: inherit; cursor: pointer;">
              <div class="avatar" style="width: 38px; height: 38px;">
                <Plate seed={artist.seed ?? 0} density={0.6} client:load />
              </div>
              <div>
                <div class="mono" style="font-size: 13px;">{artist.name}</div>
                <div class="mono faint" style="font-size: 11px; letter-spacing: .06em;">{artist.city} · {design.style}</div>
              </div>
            </a>
          )}

          <div style="display: flex; align-items: baseline; gap: 14px; padding: 22px 0; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); margin-bottom: 26px;">
            <span class="price-big">{fmtUsdt(design.price)}</span>
            <span class="mono faint" style="font-size: 11px; letter-spacing: .06em;">
              {design.selling_mode === "one-time" ? "SOULBOUND" : `RESELLABLE · ${design.royalty_pct ?? 0}% ROYALTY`}
            </span>
          </div>

          <div style="display: flex; flex-direction: column; gap: 12px; margin-bottom: 26px;">
            {design.status === "available" ? (
              <>
                <a href={`/checkout/${design.id}`} class="btn btn--solid btn--block btn--lg">Acquire this plate</a>
                {artist && (
                  <a href={`/booking?designId=${design.id}`} class="btn btn--ghost btn--block">
                    Book {artist.name.split(" ")[0]} to ink it
                  </a>
                )}
              </>
            ) : (
              <button class="btn btn--ghost btn--block btn--lg" disabled>
                🔒 {design.status === "reserved" ? "Reserved" : "Claimed — retired"}
              </button>
            )}
          </div>

          <div class="cert">
            <div class="cert__head">
              <span class="t">Certificate of plate</span>
              <span class="cert__seal">{design.n}</span>
            </div>
            <div class="cert__rows">
              {[
                ["Edition", "№ " + design.n + " / 001"],
                ["Medium", "Digital ink plate"],
                ["Placement", design.placement ?? "—"],
                ["Watching", String(design.drawn ?? 0) + " collectors"],
              ].map(([k, v]) => (
                <div class="cert__row">
                  <span class="k">{k}</span>
                  <span class="v">{v}</span>
                </div>
              ))}
            </div>
          </div>

          <p class="dim" style="font-size: 13.5px; margin-top: 26px; margin-bottom: 0;">
            Drawn by hand and held in escrow until claimed.
            {design.drawn != null && <> {design.drawn} collectors are watching this plate.</>}
            {" "}On purchase it leaves the gallery permanently — the artist will ink it once, for you, and never again.
          </p>
        </div>
      </div>

      {resaleListings.length > 0 && (
        <div style="margin-top: 56px;">
          <div class="divider-label mono faint" style="font-size: 11px; letter-spacing: .2em; text-transform: uppercase; margin-bottom: 20px;">
            Active resale listings
          </div>
          <table style="width:100%;border:1px solid var(--line);border-collapse:collapse;">
            <thead>
              <tr>
                <th class="mono" style="font-size:10px;text-align:left;padding:10px 14px;border-bottom:1px solid var(--line);color:var(--fg-faint);letter-spacing:.1em">Seller</th>
                <th class="mono" style="font-size:10px;text-align:left;padding:10px 14px;border-bottom:1px solid var(--line);color:var(--fg-faint);letter-spacing:.1em">Price</th>
                <th class="mono" style="font-size:10px;text-align:left;padding:10px 14px;border-bottom:1px solid var(--line);color:var(--fg-faint);letter-spacing:.1em">Listed</th>
                <th class="mono" style="font-size:10px;text-align:left;padding:10px 14px;border-bottom:1px solid var(--line);color:var(--fg-faint);letter-spacing:.1em">Action</th>
              </tr>
            </thead>
            <tbody>
              {resaleListings.map((r) => (
                <tr>
                  <td class="mono" style="font-size:11px;padding:10px 14px;border-bottom:1px solid var(--line);color:var(--fg-dim)">
                    {r.seller_wallet.slice(0, 6)}…{r.seller_wallet.slice(-4)}
                  </td>
                  <td class="display" style="font-size:16px;padding:10px 14px;border-bottom:1px solid var(--line)">
                    {r.asking_price.toFixed(2)} USDT
                  </td>
                  <td class="mono" style="font-size:11px;padding:10px 14px;border-bottom:1px solid var(--line);color:var(--fg-dim)">
                    {fmtDate(r.created_at)}
                  </td>
                  <td style="padding:10px 14px;border-bottom:1px solid var(--line)">
                    <a href={`/checkout/${design.id}?resale=${r.id}`} class="btn btn--solid" style="font-size:11px;padding:6px 14px">Buy resale</a>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )}

      {moreDesigns.length > 0 && artist && (
        <div style="margin-top: 72px;">
          <div class="divider-label mono faint" style="font-size: 11px; letter-spacing: .2em; text-transform: uppercase;">
            More from {artist.name}
          </div>
          <div class="grid market-grid">
            {moreDesigns.map((m) => (
              <a href={`/design/${m.id}`} style="display: block; text-decoration: none; color: inherit;">
                <div class="card">
                  <div class="card__img">
                    {m.image_url ? (
                      <img src={m.image_url} alt={m.title} style="width:100%;height:100%;object-fit:cover;display:block" />
                    ) : (
                      <Plate seed={m.seed ?? 0} density={1} client:load />
                    )}
                  </div>
                  <div class="card__body">
                    <h3 class="display" style="font-size: 20px; margin-bottom: 8px;">{m.title}</h3>
                    <div class="mono dim" style="font-size: 11px;">{m.style}</div>
                    <div class="display" style="font-size: 22px; margin-top: 12px;">{fmtUsdt(m.price)}</div>
                  </div>
                </div>
              </a>
            ))}
          </div>
        </div>
      )}
    </div>
  </section>

  <Footer />
</Base>

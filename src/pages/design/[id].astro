---
export const prerender = false;

import Base from "../../layouts/Base.astro";
import Nav from "../../components/Nav";
import Footer from "../../components/Footer.astro";
import Toast from "../../components/Toast";
import Plate from "../../components/Plate";
import ResaleButton from "../../components/ResaleButton";

const { id } = Astro.params;

interface DesignRow {
  id: string;
  n: string;
  title: string;
  artist_id: string;
  style: string | null;
  price: number | null;
  status: string;
  placement: string | null;
  seed: number | null;
  drawn: number | null;
  token_id: number | null;
  ipfs_cid: string | null;
  image_url: string | null;
  selling_mode: string;
  royalty_pct: number | null;
}

interface ResaleListingRow {
  id: string;
  seller_wallet: string;
  asking_price: number;
  created_at: number;
  status: string;
}

interface ArtistRow {
  id: string;
  name: string;
  city: string | null;
  style: string | null;
  seed: number | null;
}

let design: DesignRow | null = null;
let artist: ArtistRow | null = null;
let moreDesigns: DesignRow[] = [];
let resaleListings: ResaleListingRow[] = [];

try {
  const db = Astro.locals.runtime.env.DB;
  design = await db
    .prepare("SELECT id, n, title, artist_id, style, price, status, placement, seed, drawn, token_id, ipfs_cid, image_url, selling_mode, royalty_pct FROM designs WHERE id = ?")
    .bind(id)
    .first<DesignRow>();
  if (design) {
    const [aRow, mRes, rRes] = await Promise.all([
      db
        .prepare("SELECT id, name, city, style, seed FROM artists WHERE id = ?")
        .bind(design.artist_id)
        .first<ArtistRow>(),
      db
        .prepare("SELECT id, n, title, artist_id, style, price, status, placement, seed, drawn, image_url, selling_mode, royalty_pct, token_id FROM designs WHERE artist_id = ? AND id != ? AND status IN ('available','reserved','sold') ORDER BY rowid ASC LIMIT 3")
        .bind(design.artist_id, id)
        .all<DesignRow>(),
      db
        .prepare("SELECT id, seller_wallet, asking_price, created_at, status FROM resale_listings WHERE design_id = ? AND status = 'active' ORDER BY asking_price ASC")
        .bind(id)
        .all<ResaleListingRow>(),
    ]);
    artist = aRow;
    moreDesigns = mRes.results;
    resaleListings = rRes.results;
  }
} catch {
  // fallback
}

if (!design) {
  return Astro.redirect("/market");
}

function fmtUsdt(v: number | null) {
  if (!v) return "—";
  return v.toFixed(2) + " USDT";
}

function fmtDate(ts: number) {
  return new Date(ts * 1000).toLocaleString("en-GB", {
    day: "2-digit", month: "short", year: "numeric",
  });
}

const PRIVY_APP_ID = Astro.locals.runtime.env.PRIVY_APP_ID;
---

<Base
  title={design.title + " — SUKNID"}
  description={`${design.title} by ${artist?.name ?? ""}. One-of-one tattoo plate.`}
>
  <Nav client:load currentPath="/market" />
  <Toast client:load />

  <section class="py-8 pb-20">
    <div class="max-w-container-max mx-auto px-5 md:px-16">
      <a href="/market" class="inline-flex items-center gap-2 text-on-surface-variant hover:text-on-surface mb-8 font-body text-sm transition-colors duration-200">← Back to gallery</a>

      <div class="grid grid-cols-1 lg:grid-cols-[1fr_400px] gap-8 lg:gap-12">
        {/* ── Plate display ── */}
        <div class="card-bb aspect-square overflow-hidden !border-outline-variant/20">
          {design.image_url ? (
            <img src={design.image_url} alt={design.title} style="width:100%;height:100%;object-fit:cover;display:block" />
          ) : (
            <Plate seed={design.seed ?? 0} label={design.title.toUpperCase()} index={design.n} density={1.3} client:load />
          )}
        </div>

        {/* ── Detail panel ── */}
        <div class="flex flex-col">
          <div class="flex justify-between items-center mb-[22px]">
            <span class={`tag-bb text-xs border ${design.status === "available" ? "bg-green-600/10 text-green-700 border-green-600/30" : design.status === "reserved" ? "bg-amber-500/10 text-amber-600 border-amber-500/30" : "bg-on-surface-variant/10 text-on-surface-variant border-on-surface-variant/30"}`}>
              <span class="w-2 h-2 rounded-full bg-current"></span>
              {design.status === "available" ? "Available" : design.status === "reserved" ? "Reserved" : "Claimed"}
            </span>
            <span class="font-body text-on-surface-variant/60 text-label-sm tracking-wider">№ {design.n} / 001</span>
          </div>
          {design.status === "sold" && design.selling_mode === "resellable" && design.token_id != null && (
            <div class="mb-4">
              <ResaleButton
                client:load
                designId={design.id}
                tokenId={design.token_id}
                appId={PRIVY_APP_ID}
              />
            </div>
          )}
          <h1 class="font-display font-semibold text-on-surface text-display-lg-mobile md:text-[46px] leading-none">{design.title}</h1>

          {artist && (
            <a href={`/artist/${artist.id}`} class="flex items-center gap-3 my-5 mb-7 no-underline text-inherit cursor-pointer group/artist">
              <div class="w-[38px] h-[38px] rounded-full overflow-hidden flex-shrink-0 ring-1 ring-outline-variant/30">
                <Plate seed={artist.seed ?? 0} density={0.6} client:load />
              </div>
              <div>
                <div class="font-body text-sm text-on-surface group-hover/artist:text-primary-container transition-colors duration-200">{artist.name}</div>
                <div class="font-body text-xs text-on-surface-variant tracking-wide">{artist.city} · {design.style}</div>
              </div>
            </a>
          )}

          <div class="flex items-baseline gap-3.5 py-[22px] border-t border-outline-variant/20 border-b border-outline-variant/20 mb-[26px]">
            <span class="font-display text-headline-sm text-on-surface">{fmtUsdt(design.price)}</span>
            <span class="font-body text-on-surface-variant/60 text-xs tracking-wide">
              {design.selling_mode === "one-time" ? "SOULBOUND" : `RESELLABLE · ${design.royalty_pct ?? 0}% ROYALTY`}
            </span>
          </div>

          <div class="flex flex-col gap-3 mb-[26px]">
            {design.status === "available" ? (
              <>
                <a href={`/checkout/${design.id}`} class="btn-primary w-full">Acquire this plate</a>
                {artist && (
                  <a href={`/booking?designId=${design.id}`} class="btn-secondary w-full">
                    Book {artist.name.split(" ")[0]} to ink it
                  </a>
                )}
              </>
            ) : (
              <button class="btn-secondary w-full" disabled>
                🔒 {design.status === "reserved" ? "Reserved" : "Claimed — retired"}
              </button>
            )}
          </div>

          <div class="bg-surface-container rounded-lg border border-outline-variant/30 p-6">
            <div class="flex justify-between items-center mb-4 pb-3 border-b border-outline-variant/20">
              <span class="font-display font-semibold text-on-surface">Certificate of plate</span>
              <span class="w-14 h-14 rounded-full bg-primary-container text-on-primary-container flex items-center justify-center font-body font-bold text-lg">{design.n}</span>
            </div>
            <div class="flex flex-col gap-3">
              {[
                ["Edition", "№ " + design.n + " / 001"],
                ["Medium", "Digital ink plate"],
                ["Placement", design.placement ?? "—"],
                ["Watching", String(design.drawn ?? 0) + " collectors"],
              ].map(([k, v]) => (
                <div class="flex justify-between font-body text-sm">
                  <span class="text-on-surface-variant">{k}</span>
                  <span class="text-on-surface font-medium">{v}</span>
                </div>
              ))}
            </div>
          </div>

          <p class="text-on-surface-variant text-sm mt-[26px] mb-0 leading-relaxed">
            Drawn by hand and held in escrow until claimed.
            {design.drawn != null && <> {design.drawn} collectors are watching this plate.</>}
            {" "}On purchase it leaves the gallery permanently — the artist will ink it once, for you, and never again.
          </p>
        </div>
      </div>

      {/* ── Resale listings ── */}
      {resaleListings.length > 0 && (
        <div class="mt-14">
          <div class="font-body text-label-sm tracking-wider uppercase text-on-surface-variant/60 mb-5">
            Active resale listings
          </div>
          <div class="card-bb overflow-x-auto">
            <table class="w-full border-collapse">
              <thead>
                <tr>
                  <th class="font-body text-[10px] text-left p-3 px-4 border-b border-outline-variant/20 text-on-surface-variant/60 tracking-wider">Seller</th>
                  <th class="font-body text-[10px] text-left p-3 px-4 border-b border-outline-variant/20 text-on-surface-variant/60 tracking-wider">Price</th>
                  <th class="font-body text-[10px] text-left p-3 px-4 border-b border-outline-variant/20 text-on-surface-variant/60 tracking-wider">Listed</th>
                  <th class="font-body text-[10px] text-left p-3 px-4 border-b border-outline-variant/20 text-on-surface-variant/60 tracking-wider">Action</th>
                </tr>
              </thead>
              <tbody>
                {resaleListings.map((r) => (
                  <tr>
                    <td class="font-body text-xs p-3 px-4 border-b border-outline-variant/20 text-on-surface-variant">
                      {r.seller_wallet.slice(0, 6)}…{r.seller_wallet.slice(-4)}
                    </td>
                    <td class="font-display font-semibold text-on-surface text-base p-3 px-4 border-b border-outline-variant/20">
                      {r.asking_price.toFixed(2)} USDT
                    </td>
                    <td class="font-body text-xs p-3 px-4 border-b border-outline-variant/20 text-on-surface-variant">
                      {fmtDate(r.created_at)}
                    </td>
                    <td class="p-3 px-4 border-b border-outline-variant/20">
                      <a href={`/checkout/${design.id}?resale=${r.id}`} class="btn-primary text-xs !px-4 !py-2">Buy resale</a>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      )}

      {/* ── More from artist ── */}
      {moreDesigns.length > 0 && artist && (
        <div class="mt-[72px]">
          <div class="font-body text-label-sm tracking-wider uppercase text-on-surface-variant/60 mb-6">
            More from {artist.name}
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-gutter">
            {moreDesigns.map((m) => (
              <a href={`/design/${m.id}`} class="card-bb block no-underline group">
                <div class="aspect-[3/4] overflow-hidden bg-surface-dim">
                  {m.image_url ? (
                    <img src={m.image_url} alt={m.title} style="width:100%;height:100%;object-fit:cover;display:block" />
                  ) : (
                    <Plate seed={m.seed ?? 0} density={1} client:load />
                  )}
                </div>
                <div class="p-5">
                  <h3 class="font-display font-semibold text-on-surface text-xl mb-2 group-hover:text-primary transition-colors duration-200">{m.title}</h3>
                  <div class="font-body text-xs text-on-surface-variant">{m.style}</div>
                  <div class="font-display font-semibold text-on-surface text-[22px] mt-3">{fmtUsdt(m.price)}</div>
                </div>
              </a>
            ))}
          </div>
        </div>
      )}
    </div>
  </section>

  <Footer />
</Base>

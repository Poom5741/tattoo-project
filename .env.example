# Public runtime vars (safe to commit — no secrets)
PUBLIC_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
PUBLIC_CHAIN_ID=84532

BASE_RPC_PRIMARY=https://sepolia.base.org
BASE_RPC_FALLBACK=https://base-sepolia.g.alchemy.com/v2/YOUR_KEY_HERE

# Tawk.to live chat — public widget IDs (Administration → Channels → Chat Widget)
# Must also be set as BUILD-time env vars in Cloudflare Pages (Prod + Preview),
# since PUBLIC_* values are inlined at build and used by prerendered pages.
PUBLIC_TAWK_PROPERTY_ID=your_tawk_property_id
PUBLIC_TAWK_WIDGET_ID=your_tawk_widget_id
